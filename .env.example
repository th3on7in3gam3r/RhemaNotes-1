# Clerk Auth keys (publishable = browser, secret = Cloudflare Worker — REQUIRED for signed-in AI)
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
# Also set on Cloudflare Worker (Settings → Variables): CLERK_PUBLISHABLE_KEY=pk_live_…
# Set in Cloudflare Dashboard → Workers → rhemanotes → Settings → Variables (NOT in .env.local for production)
# CLERK_SECRET_KEY=sk_live_...
# FOUNDER_CLERK_IDS=user_abc123   # comma-separated Clerk user IDs → Harvest tier for project founders
# FOUNDER_EMAILS=you@example.com  # optional comma-separated founder emails → Harvest tier

# Stripe Keys and Prices
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
VITE_STRIPE_PRICE_FREE=price_1TSmM0DaUBBsjt5mlh09smbe
VITE_STRIPE_PRICE_PRO_MONTHLY=price_1TSmMiDaUBBsjt5mTa3DfYfA
VITE_STRIPE_PRICE_PRO_ANNUAL=price_1TSmNbDaUBBsjt5mBXm985Y8
VITE_STRIPE_PRICE_CHURCH=price_1TSmOfDaUBBsjt5mjrJLVLLK
STRIPE_SECRET_KEY=your_stripe_secret_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Whisper (whisper-api.com) — Worker secret only; enables long audio transcription via /api/transcribe
# WHISPER_API_KEY=your_whisper_api_key_here
# API.Bible (api.bible) — Worker secret ONLY (do NOT use VITE_ — that exposes the key in the browser)
# Production: npx wrangler secret put BIBLE_API_KEY
# Local wrangler dev: add BIBLE_API_KEY=... to .dev.vars (copy from .dev.vars.example)
